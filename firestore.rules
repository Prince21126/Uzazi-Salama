rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    
    // Admin check using the admin-bypass document's uid match or the bootstrapped administrator email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "princebamba2112@gmail.com" ||
        (exists(/databases/$(database)/documents/users/admin-bypass) && get(/databases/$(database)/documents/users/admin-bypass).data.uid == request.auth.uid)
      );
    }

    // Users collection
    match /users/{userId} {
      // Allow general read/write to prevent race conditions with localStorage session storage on page load before auth init
      allow read, get, list: if true;
      allow create, update: if true;
      allow delete: if true;

      // User logs subcollection
      match /logs/{logId} {
        allow read, get, list, write, create, update, delete: if true;
      }
    }

    // Hospitals collection
    match /hospitals/{hospitalId} {
      // Allow anyone to read, list, and create hospitals (required so the hospital onboarding can create hospital doc before auth is created)
      allow read, get, list: if true;
      allow create: if true;
      allow update, delete, write: if isSignedIn();
    }
  }
}
