rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    
    // Admin check using the admin-bypass document's uid match or the bootstrapped administrator email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "princebamba2112@gmail.com" ||
        (exists(/databases/$(database)/documents/users/admin-bypass) && get(/databases/$(database)/documents/users/admin-bypass).data.uid == request.auth.uid)
      );
    }
    
    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
             && data.language is string && data.language.size() <= 10;
    }

    // Users collection
    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if true; // Allow lookup by name/slug
      allow create: if true; // Allow public registration
      allow update: if true; // Allow profile updates
      allow delete: if isAdmin();

      // User logs subcollection
      match /logs/{logId} {
        allow read, write: if true; // Allow access to patient's logs
      }
    }

    // Hospitals collection
    match /hospitals/{hospitalId} {
      // Allow public list and read so unauthenticated onboarding users can choose their closest hospital
      allow list, read, get: if true;
      allow write, create, update, delete: if isAdmin();
    }
  }
}
